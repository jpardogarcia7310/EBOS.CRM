# SMTP
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=alerts@example.com
SMTP_AUTH_PASSWORD=change-me

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME
SLACK_DEFAULT_CHANNEL=#crm-alerts
SLACK_WARNING_CHANNEL=#crm-warning
SLACK_CRITICAL_CHANNEL=#crm-critical

# Microsoft Teams Incoming Webhook URL
TEAMS_WARNING_WEBHOOK_URL=https://outlook.office.com/webhook/CHANGE/ME
TEAMS_CRITICAL_WEBHOOK_URL=https://outlook.office.com/webhook/CHANGE/ME

# Email recipients
WARNING_EMAIL_TO=crm-warning@example.com
CRITICAL_EMAIL_TO=crm-critical@example.com

# PagerDuty Events API v2 routing key
PAGERDUTY_ROUTING_KEY=change-me
