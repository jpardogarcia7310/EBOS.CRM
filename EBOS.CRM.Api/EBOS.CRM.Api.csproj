<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>API EBOS.CRM</Title>
    <Authors>SITECAV</Authors>
    <Copyright>All rights reserved by SITECAV 2025</Copyright>
    <RepositoryUrl>https://github.com/SITECAV/EBOS.CRM</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(SolutionDir)NuGet</PackageOutputPath>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
    <PackageReference Include="Swashbuckle.AspNetCore.Versioning" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EBOS.CRM.Application\EBOS.CRM.Application.csproj" />
    <ProjectReference Include="..\EBOS.CRM.Infrastructure\EBOS.CRM.Infrastructure.csproj" />
  </ItemGroup>

</Project>
