{
  "ConnectionStrings": {
    "CrmConnection": ""
  },
  "AuditService": {
    "BaseUrl": "http://192.168.1.222:5000",
    "Enabled": true,
    "TimeoutSeconds": 10,
    "RetryCount": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Pagination": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "TenantIsolation": {
    "MinTraversalDepth": 1,
    "MaxTraversalDepth": 50,
    "TraversalDepth": 10
  },
  "MultiTenant": {
    "Strategy": "Shared",
    "SchemaPrefix": "Tenant_",
    "SchemaTargets": [ "CRM" ],
    "ConnectionStringTemplate": ""
  },
  "AllowedHosts": "*"
}
