{
  "ConnectionStrings": {
    "CrmConnection": ""
  },
  "AuditService": {
    "BaseUrl": "http://192.168.1.222:5000",
    "Enabled": true,
    "TimeoutSeconds": 10,
    "RetryCount": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Pagination": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "Authentication": {
    "Enabled": true,
    "UseAuthority": false,
    "Authority": "http://localhost:5100",
    "Audience": "ebos.crm.api",
    "MetadataAddress": "",
    "RequireHttpsMetadata": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidIssuer": "http://localhost:5100",
    "ValidIssuers": [],
    "ValidAudiences": [
      "ebos.crm.api"
    ],
    "NameClaimType": "sub",
    "RoleClaimType": "roles",
    "ClockSkewSeconds": 60,
    "SigningKey": "dev-only-ebos-auth-signing-key-change-me"
  },
  "AllowedHosts": "*"
}
